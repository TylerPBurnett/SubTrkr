{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Vite Dev Server",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 1420,
      "autoPort": true
    },
    {
      "name": "Tauri Dev (native window)",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "tauri",
        "dev"
      ],
      "port": 1420
    },
    {
      "name": "Vite Dev Server (verification)",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev:verify"
      ],
      "port": 1430
    }
  ]
}
