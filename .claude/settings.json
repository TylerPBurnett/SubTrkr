{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun run *)",
      "Bash(bun install *)",
      "Bash(bun tauri *)",
      "Bash(bunx tsc *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Read(.env)",
      "Read(.env.*)",
      "Bash(supabase db push *)",
      "Bash(supabase db pull *)",
      "Bash(supabase migration repair *)",
      "Bash(supabase migration new *)",
      "Bash(supabase link *)"
    ]
  }
}
